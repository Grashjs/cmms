# cmms4fm-mcp — every setting this server has. Copy to .env for local runs; in the deployed
# stack these are set on the `mcp` service in Coolify (and must be referenced from
# docker-compose.yml, or they never reach the container — see CLAUDE.md).

# --- required ---------------------------------------------------------------------------
# Base URL of the CMMS REST API, no trailing slash. Inside the compose network that is the
# api service directly; from a workstation it is the public domain plus /api.
CMMS_BASE_URL=http://api:8080

# --- what the client sees ---------------------------------------------------------------
# readonly | core | core-readonly | assets | workorders | full
PROFILE=readonly
# Hides every writing tool whatever the profile says. Use it for a client that processes
# input nobody vouched for.
READ_ONLY=false
# Comma-separated globs, applied on top of the profile. A deny always wins.
TOOLS_ALLOW=
TOOLS_DENY=

# --- authentication ---------------------------------------------------------------------
# passthrough: the client presents its own key per request (x-api-key header, or
#              CMMS_API_KEY on stdio). Rights and audit stay with the real user.
# service:     this server forwards one key from its own environment.
AUTH_MODE=passthrough
# Only for AUTH_MODE=service. Never commit a real key — this repository is public.
SERVICE_API_KEY=
# Only for MCP_TRANSPORT=stdio with AUTH_MODE=passthrough.
CMMS_API_KEY=

# --- transport --------------------------------------------------------------------------
# http (remote clients, Streamable HTTP) | stdio (a desktop client that launches this process)
MCP_TRANSPORT=http
PORT=8081
HOST=0.0.0.0

# --- limits -----------------------------------------------------------------------------
# Tool calls per minute per API key. 0 disables the limit.
RATE_LIMIT=120
RATE_LIMIT_BURST=
REQUEST_TIMEOUT_MS=30000
# Characters of a CMMS response passed on before it is truncated.
MAX_RESPONSE_CHARS=60000
# How deep $ref chains are inlined into a tool input schema, and the size at which a schema
# is pruned to its top level.
MAX_SCHEMA_DEPTH=6
MAX_SCHEMA_CHARS=12000

# --- the OpenAPI document ---------------------------------------------------------------
# Defaults to ${CMMS_BASE_URL}/v3/api-docs/${SPEC_GROUP}. Note the group: this API disables
# the default document, so plain /v3/api-docs answers 404.
SPEC_GROUP=atlas-cmms
SPEC_URL=
# Local fallback, used only when the URL cannot be reached.
SPEC_FILE=
# Re-read the document every N minutes so a new upstream endpoint becomes a tool without a
# redeploy. 0 disables it.
SPEC_REFRESH_MINUTES=0

# --- optional MCP features --------------------------------------------------------------
ENABLE_RESOURCES=true
ENABLE_PROMPTS=true
LOG_LEVEL=info
